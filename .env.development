# ============================================
# N8N ENVIRONMENT CONFIGURATION - DEVELOPMENT MODE
# ============================================
# Forzar uso del VPS en modo desarrollo
VITE_N8N_ENVIRONMENT=production

# N8N Local Configuration
VITE_N8N_LOCAL_API_URL=http://localhost:5678/api/v1
VITE_N8N_LOCAL_WEBHOOK_URL=http://localhost:5678/webhook
VITE_N8N_LOCAL_API_TOKEN=your_local_n8n_api_token_here

# N8N Production Configuration (VPS Hostinger)
VITE_N8N_PROD_API_URL=https://n8n-n8n.hrxtio.easypanel.host/api/v1
VITE_N8N_PROD_WEBHOOK_URL=https://n8n-n8n.hrxtio.easypanel.host/webhook
VITE_N8N_PROD_API_TOKEN=your_production_n8n_api_token_here

# Development Mode (legacy - mantener para compatibilidad)
VITE_FORCE_LOCAL_N8N=false

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# App Configuration
VITE_APP_TITLE=DashboardAI
VITE_APP_VERSION=1.0.0

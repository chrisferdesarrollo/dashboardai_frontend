# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Cambiar entre: 'local' para desarrollo o 'production' para producción
VITE_N8N_ENVIRONMENT=production

# ============================================
# N8N CONFIGURATION
# ============================================
# N8N Local Configuration
VITE_N8N_LOCAL_API_URL=https://n8n.topias.app/api/v1
VITE_N8N_LOCAL_WEBHOOK_URL=https://n8n.topias.app/webhook
#VITE_N8N_LOCAL_API_TOKEN=your_local_n8n_api_token_here

# N8N Production Configuration
VITE_N8N_PROD_API_URL=https://n8n.topias.app/api/v1
VITE_N8N_PROD_WEBHOOK_URL=https://n8n.topias.app/webhook

# ============================================
# BACKEND API CONFIGURATION  
# ============================================
# Para desarrollo local, cambiar a: http://localhost:8080/api
# Para producción: https://topias.app/api

VITE_API_BASE_URL=https://topias.app/api
VITE_API_URL=https://topias.app/api

# ============================================
# APP CONFIGURATION
# ============================================
VITE_APP_TITLE=DashboardAI
VITE_APP_VERSION=1.0.0

# ============================================
# N8N ENVIRONMENT CONFIGURATION
# ============================================
# Example Environment Variables for DashboardAI Frontend
# Copy this file to .env and update the values according to your environment

# Cambia entre: 'local' o 'production'
VITE_N8N_ENVIRONMENT=local

# N8N Local Configuration
VITE_N8N_LOCAL_API_URL=http://localhost:5678/api/v1
#VITE_N8N_LOCAL_WEBHOOK_URL=http://localhost:5678/webhook
VITE_N8N_LOCAL_API_TOKEN=your_local_n8n_api_token_here

# N8N Production Configuration (update with your VPS URLs)
VITE_N8N_PROD_API_URL=https://your-n8n-server.com/api/v1
VITE_N8N_PROD_WEBHOOK_URL=https://your-n8n-server.com/webhook
VITE_N8N_PROD_API_TOKEN=your_production_n8n_api_token_here

# Legacy variables (for backward compatibility)
VITE_FORCE_LOCAL_N8N=true

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# App Configuration
VITE_APP_TITLE=DashboardAI
VITE_APP_VERSION=1.0.0

# ============================================
# QUICK SETUP INSTRUCTIONS:
# ============================================
# 1. For LOCAL development:
#    Set VITE_N8N_ENVIRONMENT=local
#    Or run: ./switch-n8n.ps1 and select option 1
#
# 2. For PRODUCTION (VPS):
#    Set VITE_N8N_ENVIRONMENT=production
#    Or run: ./switch-n8n.ps1 and select option 2
